@Tutorial(time: 50) {
    @Intro(title: "9단계: 모든 기능을 한 화면에 연결하기") {
        데이터가 준비되고 AR 추적이 안정되면 시각화를 자동 배치하고, 상단 정보와 새로고침만 남긴 완성 화면을 만듭니다.

        @Image(source: "air-ar-hero.svg", alt: "상태 패널과 AR 시각화가 통합된 앱")
    }

    @Section(title: "AR 수명 주기 연결하기") {
        @ContentAndMedia {
            Coordinator는 SwiftUI의 값 변화와 ARView의 세션·프레임 이벤트를 연결합니다. Anchor는 한 번 배치하고 데이터가 바뀌면 그 아래 Entity만 다시 만듭니다.
        }
        @Steps {
            @Step {
                place, update, reset 명령을 ARExperienceController의 closure로 Coordinator에 전달합니다.
            }
            @Step {
                SceneEvents.Update에서 파티클 재생 상태, UV 맥동, 코로나 방향, 낮·밤과 플레어를 갱신합니다.

                @Code(name: "AirQualityARView.swift", file: "08-AirQualityARView.swift")
            }
            @Step {
                화면이 사라지면 구독을 취소하고 ARSession을 pause해 카메라와 GPU 자원을 정리합니다.
            }
        }
    }

    @Section(title: "SwiftUI 화면 완성하기") {
        @ContentAndMedia {
            ZStack의 아래에는 ARView, 위에는 상태 패널과 새로고침 버튼을 둡니다. snapshot과 sessionState가 모두 준비됐을 때만 자동 배치합니다.
        }
        @Steps {
            @Step {
                상단에 온도, 미세먼지, UV를 한 줄로 표시하고 로딩과 오류도 같은 영역에서 안내합니다.
            }
            @Step {
                위치 권한이 거부된 경우에만 설정 열기 버튼을 표시합니다.
            }
            @Step {
                onChange에서 새 snapshot을 기존 AR 시각화에 반영하고, 첫 결과라면 현재 카메라 위치에 배치합니다.

                @Code(name: "ContentView.swift", file: "09-ContentView.swift")
            }
        }
    }

    @Section(title: "접근성과 완료 확인") {
        @ContentAndMedia {
            완료 체크포인트: 앱 실행 후 권한과 데이터가 준비되면 버튼 없이 AR이 나타나고, 새로고침하면 수치와 공간 표현이 함께 바뀝니다.
        }
        @Steps {
            @Step {
                환경 수치에 VoiceOver 설명을 제공하고 동작 줄이기 설정에서는 파티클과 맥동을 멈춥니다.
            }
            @Step {
                AR 오버레이가 터치를 막으면 isUserInteractionEnabled를 false로 설정합니다. 이제 마지막 10단계 검증으로 이동합니다.
            }
        }
    }
}
