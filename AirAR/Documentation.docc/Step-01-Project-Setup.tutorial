@Tutorial(time: 15) {
    @Intro(title: "1단계: 아이폰에서 실행되는 빈 앱과 권한 준비하기") {
        SwiftUI 기반 iOS 프로젝트를 만들고 위치·카메라 권한, 앱 서명과 실제 기기 실행 환경을 설정합니다. 이 단계가 끝나면 자신의 Bundle Identifier로 서명된 기본 앱이 아이폰에서 실행됩니다.

        @Image(source: "air-ar-hero.svg", alt: "이번 과정에서 완성할 AirAR 앱")
    }

    @Section(title: "새 iOS 앱 프로젝트 만들기") {
        @ContentAndMedia {
            macOS와 Xcode 16 이상, iOS 18 이상을 실행하는 ARKit 지원 iPhone 또는 iPad가 필요합니다. Apple ID를 Xcode에 등록해 두면 무료 개인 개발 팀으로도 자신의 기기에서 실행할 수 있습니다. 이후 코드 블록은 설명용 일부 코드가 아니라 파일 전체이므로 중간 줄을 생략하지 않고 복사합니다.
        }
        @Steps {
            @Step {
                Xcode에서 File > New > Project > iOS App을 선택합니다. Product Name은 `AirAR`, Interface는 SwiftUI, Language는 Swift, Storage는 None으로 지정합니다. 테스트 선택 항목은 어느 쪽이어도 되며, 선택하지 않았다면 6단계에서 테스트 Target을 추가합니다.
            }
            @Step {
                프로젝트 탐색기에서 파란색 AirAR 프로젝트를 선택하고 AirAR Target을 엽니다. General의 Minimum Deployments를 iOS 18.0으로 맞춘 뒤 Signing & Capabilities에서 자신의 Team을 선택합니다. Bundle Identifier는 `com.자신의이름.AirAR`처럼 다른 앱과 겹치지 않는 값으로 바꿉니다.
            }
            @Step {
                프로젝트 탐색기의 AirAR 그룹을 오른쪽 클릭해 `Models`, `Services`, `ViewModels`, `Views`, `AR` 그룹을 만듭니다. 이 그룹은 이후 파일을 역할별로 찾기 쉽게 정리하기 위한 것이며, 디스크 폴더가 아닌 노란색 Group으로 만들어도 앱 동작에는 차이가 없습니다.
            }
            @Step {
                생성된 `AirARApp.swift`가 아래와 같은지 확인합니다. 같은 파일을 하나 더 만들면 `@main` 중복 오류가 나므로 기존 파일만 유지합니다.

                @Code(name: "AirARApp.swift", file: "01-AirARApp.swift")
            }
        }
    }

    @Section(title: "위치·카메라 권한과 아이폰 실행 설정하기") {
        @ContentAndMedia {
            위치는 현재 지역의 API 요청 좌표를 만드는 데 사용하고, 카메라는 증강현실 월드 추적에 사용합니다. iOS는 사용 이유가 Info에 등록되지 않은 상태에서 보호 기능에 접근하면 앱을 종료하므로 두 설명을 반드시 추가해야 합니다.
        }
        @Steps {
            @Step {
                AirAR Target > Info > Custom iOS Target Properties에서 `Privacy - Location When In Use Usage Description`과 `Privacy - Camera Usage Description`을 추가하고 아래 문구를 입력합니다. 키가 이미 있으면 중복 추가하지 말고 기존 값만 수정합니다.

                @Code(name: "Info.plist에 추가할 권한 키", file: "01-Permissions.plist")
            }
            @Step {
                케이블 또는 같은 Wi-Fi로 iPhone을 Mac에 연결합니다. 기기의 설정 > 개인정보 보호 및 보안 > 개발자 모드가 꺼져 있다면 켠 뒤 안내에 따라 재시동합니다. 처음 연결했다면 Mac과 iPhone 양쪽에서 이 컴퓨터를 신뢰합니다.
            }
            @Step {
                Xcode 상단 실행 대상을 연결한 iPhone으로 선택하고 Command-R을 누릅니다. 처음에는 개발자 인증과 앱 설치에 시간이 걸릴 수 있습니다. 서명 오류 없이 기본 SwiftUI 화면이 기기에 나타나면 1단계 체크포인트를 통과했습니다.
            }
        }
    }
}
