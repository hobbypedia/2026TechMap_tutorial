@Tutorial(time: 30) {
    @Intro(title: "3단계: 받은 환경 데이터를 앱 화면에 표시하기") {
        위치와 네트워크 작업을 화면 상태 처리 코드에 연결하고 현재 지역 이름, 기온, 미세먼지와 자외선을 표시합니다. 이 단계가 끝나면 자신의 아이폰에서 현재 위치의 실제 환경 수치를 새로고침할 수 있습니다.

        @Image(source: "air-ar-hero.svg", alt: "서비스 데이터가 ViewModel을 거쳐 SwiftUI 화면에 표시되는 구조")
    }

    @Section(title: "로딩·성공·오류를 관리하는 화면 상태 만들기") {
        @ContentAndMedia {
            `ViewModels` 그룹에 두 파일을 추가합니다. ViewModel은 위치를 요청한 뒤 환경 데이터를 받아 로딩·성공·실패 상태를 갱신합니다. 사용자가 새로고침을 빠르게 여러 번 눌렀을 때 이전 작업을 취소하는 처리도 화면 코드와 분리해 관리합니다.
        }
        @Steps {
            @Step {
                `AirQualityMetricViewModel.swift`를 만들고 상단의 환경 수치 한 칸에 필요한 제목, 값, 단위, 상태 문구와 색상을 묶습니다.

                @Code(name: "AirQualityMetricViewModel.swift", file: "03-AirQualityMetricViewModel.swift")
            }
            @Step {
                `AirQualityViewModel.swift`를 만들고 위치 서비스와 Open-Meteo 서비스를 순서대로 호출하는 전체 로직을 추가합니다. 권한 거부, 네트워크 오류, 작업 취소와 설정 화면 이동도 이 파일에서 처리합니다.

                @Code(name: "AirQualityViewModel.swift", file: "03-AirQualityViewModel.swift")
            }
        }
    }

    @Section(title: "지역 이름과 세 가지 환경 수치를 화면에 연결하기") {
        @ContentAndMedia {
            `Views` 그룹에 재사용 가능한 표시용 View 두 개를 추가합니다. 마지막에는 Xcode가 만든 기존 `ContentView.swift`의 내용을 전부 교체합니다. 새 `ContentView.swift`를 하나 더 만들면 같은 타입이 중복되므로 기존 파일을 사용합니다.
        }
        @Steps {
            @Step {
                `MetricView.swift`를 만들고 제목, 수치, 단위와 환경 상태를 세로로 배치하는 한 칸짜리 View를 추가합니다.

                @Code(name: "MetricView.swift", file: "03-MetricView.swift")
            }
            @Step {
                `AirQualityStatusPanel.swift`를 만들고 현재 지역 이름 아래에 온도·미세먼지·자외선 세 칸을 한 줄로 배치합니다.

                @Code(name: "AirQualityStatusPanel.swift", file: "03-AirQualityStatusPanel.swift")
            }
            @Step {
                기존 `ContentView.swift`의 내용을 모두 선택해 아래 코드로 교체합니다. 이 화면은 ViewModel을 한 번만 생성하고, 처음 나타날 때 데이터를 불러오며 로딩 표시·오류 안내·설정·새로고침 버튼을 상태에 맞춰 보여 줍니다.

                @Code(name: "ContentView.swift", file: "03-ContentView.swift")
            }
        }
    }

    @Section(title: "내 위치의 실제 수치가 표시되는지 확인하기") {
        @ContentAndMedia {
            시뮬레이터에서는 상단 메뉴의 Features > Location에서 Apple 또는 Custom Location을 선택해야 좌표가 들어옵니다. 실제 기기에서는 앱을 사용하는 동안 위치 권한을 허용하고 인터넷 연결을 유지합니다. 처음 요청은 위치 측정과 지역 이름 변환 때문에 잠시 걸릴 수 있습니다.
        }
        @Steps {
            @Step {
                Command-R로 실행하고 위치 권한 창에서 `앱을 사용하는 동안 허용`을 선택합니다. 로딩 표시가 사라진 뒤 지역 이름과 온도·미세먼지·자외선 숫자, 단위와 상태 문구가 표시되는지 확인합니다.
            }
            @Step {
                하단 새로고침 버튼을 누릅니다. 다시 로딩된 뒤 수치가 나타나는지 확인합니다. 권한을 거부했다면 한국어 오류 안내와 `위치 설정 열기` 버튼이 나타나야 하며, 설정에서 권한을 변경한 뒤 재시도할 수 있어야 합니다.
            }
            @Step {
                실제 수치가 나타나고 새로고침과 오류 안내가 동작하면 3단계를 통과했습니다. 지금부터는 이 앱을 삭제하지 않고 같은 프로젝트에 증강현실 화면을 추가합니다.
            }
        }
    }
}
