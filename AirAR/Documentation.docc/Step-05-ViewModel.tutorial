@Tutorial(time: 40) {
    @Intro(title: "5단계: ViewModel로 앱 상태 관리하기") {
        위치와 API 요청을 화면에서 분리하고 로딩, 성공, 실패, 새로고침 상태를 한곳에서 관리합니다.

        @Image(source: "air-ar-hero.svg", alt: "Service 결과가 ViewModel을 거쳐 SwiftUI로 전달되는 구조")
    }

    @Section(title: "화면과 작업 분리하기") {
        @ContentAndMedia {
            ViewModel은 화면에 필요한 상태와 작업을 소유합니다. @MainActor는 UI 상태 변경을 메인 실행 흐름에서 처리하게 하고, ObservableObject는 변경 사실을 SwiftUI에 알립니다.
        }
        @Steps {
            @Step {
                loadState, snapshot, 권한 설정 버튼 표시 여부와 현재 Task를 선언합니다.

                @Code(name: "AirQualityViewModel 시작", file: "03-AirQualityViewModel-start.swift")
            }
            @Step {
                load에서 위치를 얻고 서비스를 호출한 뒤 API의 현재 위치 이름을 역지오코딩된 지역 이름으로 바꿉니다.
            }
            @Step {
                새로고침에서는 이전 Task를 취소하고 generation 번호로 늦게 도착한 과거 응답을 무시합니다.

                @Code(name: "AirQualityViewModel 완성", file: "03-AirQualityViewModel.swift", previousFile: "03-AirQualityViewModel-start.swift")
            }
        }
    }

    @Section(title: "표시할 값 만들기") {
        @ContentAndMedia {
            View는 숫자 포맷과 상태 등급을 다시 계산하지 않습니다. ViewModel이 온도, PM2.5, UV 값을 문자열과 접근성 설명으로 준비합니다.
        }
        @Steps {
            @Step {
                로딩 중에는 대시를, 성공하면 소수점 한 자리와 환경 단계 색을, 실패하면 사용자가 이해할 한국어 오류를 제공합니다.
            }
            @Step {
                위치 권한 오류일 때만 설정 앱으로 이동하는 버튼을 표시합니다.
            }
        }
    }

    @Section(title: "완료 확인과 문제 해결") {
        @ContentAndMedia {
            완료 체크포인트: 최초 로드, 실패 후 재시도, 빠른 연속 새로고침에서 항상 최신 결과만 화면에 남습니다.
        }
        @Steps {
            @Step {
                Publishing changes from background threads 경고가 나오면 ViewModel과 상태 변경 위치에 @MainActor가 적용됐는지 확인합니다.
            }
            @Step {
                요청이 두 번 실행되면 loadTask가 이미 있을 때 load가 반환하는지 확인합니다. 이제 6단계 AR 기초로 이동합니다.
            }
        }
    }
}
