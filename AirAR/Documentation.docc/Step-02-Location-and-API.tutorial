@Tutorial(time: 40) {
    @Intro(title: "2단계: 현재 위치로 기상·대기질 데이터 가져오기") {
        Core Location으로 현재 좌표와 지역 이름을 얻고 Open-Meteo의 기상 API와 대기질 API를 동시에 호출합니다. 이 단계에서 추가하는 여덟 파일은 뒤 단계에서 화면과 증강현실이 계속 사용하는 실제 데이터 계층이며, 연습 후 삭제하는 코드는 없습니다.

        @Image(source: "chapter1-2-3-1.png", alt: "chapter1-2-3-1")
    }

    @Section(title: "API 응답과 앱에서 사용할 데이터 형태 만들기") {
        @ContentAndMedia {
            서버의 JSON 모양을 그대로 읽는 응답 구조와 앱 내부에서 사용하기 편한 데이터 구조를 분리합니다. 이렇게 하면 API 필드가 바뀌어도 화면과 증강현실 코드를 한꺼번에 수정하지 않아도 됩니다. `Models` 그룹에서 각 파일명의 Swift 파일을 만들고 각 코드 블록 전체를 입력합니다.
        }
        @Steps {
            @Step {
                `AirQualityAPIResponse.swift`를 만들고 두 API의 JSON 키, 현재 관측값과 일출·일몰 배열을 해석하는 응답 구조를 추가합니다.

                @Code(name: "AirQualityAPIResponse.swift", file: "02-AirQualityAPIResponse.swift")
            }
            @Step {
                `AirQualityLevel.swift`를 만들고 온도·미세먼지·자외선 수치를 매우 좋음부터 매우 나쁨까지 다섯 단계로 바꾸는 기준과 표시 색상을 추가합니다.

                @Code(name: "AirQualityLevel.swift", file: "02-AirQualityLevel.swift")
            }
            @Step {
                `AirQualitySnapshot.swift`를 만들고 한 번의 요청으로 얻은 기온, PM2.5, UV, 바람, 일출·일몰을 하나로 묶습니다. 화면의 대기·로딩·성공·실패 상태도 함께 정의합니다.

                @Code(name: "AirQualitySnapshot.swift", file: "02-AirQualitySnapshot.swift")
            }
            @Step {
                `UserLocation.swift`를 만들고 API 요청에 사용할 위도·경도와 사용자 화면에 보여 줄 지역 이름을 하나로 묶습니다.

                @Code(name: "UserLocation.swift", file: "02-UserLocation.swift")
            }
        }
    }

    @Section(title: "위치 권한과 Open-Meteo 요청 구현하기") {
        @ContentAndMedia {
            `Services` 그룹에는 위치와 네트워크 작업의 규칙을 선언하는 프로토콜 두 개와 실제 구현 두 개를 추가합니다. 프로토콜을 먼저 두면 6단계 테스트에서 GPS와 실제 서버 대신 가짜 데이터를 넣을 수 있습니다. Open-Meteo는 API 키가 필요 없지만 앱 실행 중 인터넷 연결은 필요합니다.
        }
        @Steps {
            @Step {
                `AirQualityServiceProtocol.swift`를 만들고 좌표를 받아 환경 데이터를 돌려주는 비동기 함수와 사용자에게 보여 줄 네트워크 오류를 정의합니다.

                @Code(name: "AirQualityServiceProtocol.swift", file: "02-AirQualityServiceProtocol.swift")
            }
            @Step {
                `LocationServiceProtocol.swift`를 만들고 현재 위치 요청, 위치 설정 화면 열기와 권한 오류를 정의합니다.

                @Code(name: "LocationServiceProtocol.swift", file: "02-LocationServiceProtocol.swift")
            }
            @Step {
                `CoreLocationService.swift`를 만들고 사용 중 위치 권한 요청, 한 번의 위치 측정, 위도·경도를 시·구 단위 이름으로 바꾸는 역지오코딩을 구현합니다.

                @Code(name: "CoreLocationService.swift", file: "02-CoreLocationService.swift")
            }
            @Step {
                `OpenMeteoAirQualityService.swift`를 만들고 같은 좌표로 Weather와 Air Quality 요청을 동시에 실행합니다. 두 응답을 하나의 `AirQualitySnapshot`으로 합치고 현지 일출·일몰 문자열은 비교 가능한 `Date`로 변환합니다.

                @Code(name: "OpenMeteoAirQualityService.swift", file: "02-OpenMeteoAirQualityService.swift")
            }
        }
    }

    @Section(title: "데이터 코드가 정상적으로 연결됐는지 확인하기") {
        @ContentAndMedia {
            아직 `ContentView`가 서비스를 호출하지 않으므로 실행 화면은 1단계와 같은 것이 정상입니다. 이 체크포인트의 목적은 화면 작업 전에 모델과 서비스 여덟 파일이 서로 올바르게 연결됐는지 확인하는 것입니다.
        }
        @Steps {
            @Step {
                Command-B를 눌러 앱을 빌드합니다. `Cannot find type in scope`가 나오면 오류에 표시된 타입의 파일 이름, 코드 전체 복사 여부와 AirAR Target Membership을 확인합니다. `Build Succeeded`가 표시되면 2단계를 통과했습니다. 이 단계에서는 URL을 Safari에 직접 입력하거나 별도 화면을 만들 필요가 없습니다. 다음 단계의 ViewModel이 현재 좌표를 서비스에 전달하고 결과를 화면에 연결합니다.
                
                @Image(source: "chapter1-2-3-1.png", alt: "chapter1-2-3-1")
            }
        }
    }
}
