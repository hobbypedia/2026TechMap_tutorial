@Tutorial(time: 120) {
    @Intro(title: "현재 위치의 공기와 햇빛을 AR로 표현하기") {
        SwiftUI, ARKit, RealityKit으로 움직이는 환경 시각화를 만듭니다. 먼저 API와 REST API가 무엇인지 이해하고, Open-Meteo의 두 REST 엔드포인트를 Swift로 호출해 JSON을 앱 데이터로 바꾸는 전 과정을 실습합니다.

        @Image(source: "air-ar-hero.svg", alt: "Open-Meteo 환경 데이터가 SwiftUI와 AR 공간으로 전달되는 앱 구조")
    }

    @Section(title: "1. 프로젝트와 권한 준비") {
        @ContentAndMedia {
            iOS 18 SwiftUI 앱과 Unit Test Target을 준비합니다. 현재 좌표에는 Core Location, 공간 추적에는 카메라와 모션 센서를 사용하는 ARKit이 필요합니다. 미세먼지 표현에는 iOS 18부터 사용할 수 있는 RealityKit 파티클 이미터를 사용합니다.

            @Image(source: "air-ar-hero.svg", alt: "SwiftUI와 ARKit으로 구성된 앱 구조")
        }
        @Steps {
            @Step {
                앱 Target과 테스트 Target의 배포 버전을 iOS 18로 맞추고 SwiftUI, ARKit, RealityKit을 연결합니다.
            }
            @Step {
                `Info.plist`에 `NSCameraUsageDescription`과 `NSLocationWhenInUseUsageDescription`을 추가합니다.
            }
            @Step {
                실제 기기에서 실행할 수 있도록 Target의 Signing Team을 선택합니다.
            }
        }
    }

    @Section(title: "2. API와 REST API 이해하기") {
        @ContentAndMedia {
            API(Application Programming Interface)는 프로그램끼리 정해진 규칙으로 요청하고 응답하기 위한 접점입니다. REST는 웹의 자원을 주소로 식별하고 HTTP의 의미를 사용해 다루는 API 설계 스타일입니다.

            이 앱은 데이터를 읽으므로 HTTP `GET` 메서드를 사용합니다. 요청은 **엔드포인트**, **쿼리 매개변수**, **HTTP 메서드**로 구성되고, 응답은 **상태 코드**, **헤더**, **JSON 본문**으로 구성됩니다.

            @Image(source: "air-ar-hero.svg", alt: "앱이 REST API에 요청하고 JSON 응답을 받는 흐름")
        }
        @Steps {
            @Step {
                엔드포인트는 API가 요청을 받는 HTTPS 주소입니다. 웹 페이지 주소와 같은 URL 문법을 쓰지만, 화면용 HTML 대신 프로그램이 읽는 JSON을 돌려줍니다.
            }
            @Step {
                `?` 뒤의 `latitude=36.0` 같은 값은 쿼리 매개변수입니다. `&`로 여러 조건을 연결합니다.
            }
            @Step {
                서버는 성공하면 보통 `200...299`, 잘못된 요청이면 `400` 계열, 서버 문제면 `500` 계열 상태 코드를 보냅니다.
            }
            @Step {
                따라서 “URL로 가져온다”는 것은 REST API가 아니라는 뜻이 아닙니다. URL은 REST API의 자원을 가리키는 주소이고, 앱은 그 주소에 HTTP 요청을 보내 데이터를 받습니다.
            }
        }
    }

    @Section(title: "3. 사용할 Open-Meteo 엔드포인트 정하기") {
        @ContentAndMedia {
            한 API가 모든 값을 제공한다고 가정하지 말고 공식 문서에서 변수와 단위를 확인합니다. Weather Forecast API에서는 기온·풍속·풍향과 오늘의 일출·일몰을, Air Quality API에서는 PM2.5·UV Index를 요청합니다.

            ```text
            GET https://api.open-meteo.com/v1/forecast
              ?latitude={위도}&longitude={경도}
              &current=temperature_2m,wind_speed_10m,wind_direction_10m
              &daily=sunrise,sunset&forecast_days=1
              &wind_speed_unit=ms&timezone=auto

            GET https://air-quality-api.open-meteo.com/v1/air-quality
              ?latitude={위도}&longitude={경도}
              &current=pm2_5,uv_index&timezone=auto
            ```

            @Image(source: "world-coordinate-diagram.svg", alt: "같은 현재 좌표를 두 Open-Meteo 엔드포인트에 전달하는 흐름")
        }
        @Steps {
            @Step {
                `current`에는 필요한 변수만 쉼표로 나열해 응답 크기와 모델 복잡도를 줄입니다.
            }
            @Step {
                `wind_speed_unit=ms`로 AR 이동 계산에 쓸 풍속 단위를 m/s로 고정합니다.
            }
            @Step {
                `daily=sunrise,sunset`과 `forecast_days=1`로 조회한 위치에서 오늘 태양이 뜨고 지는 시각만 요청합니다. Open-Meteo에서 `daily` 변수를 요청할 때는 `timezone`이 필요합니다.
            }
            @Step {
                `timezone=auto`로 좌표의 현지 시각과 시간대 식별자를 받습니다. 좌표와 변수 이름은 공식 문서의 계약이므로 임의로 바꾸지 않습니다.
            }
        }
    }

    @Section(title: "4. 앱 모델과 API 응답 모델 분리하기") {
        @ContentAndMedia {
            서버의 JSON 모양을 화면 전체에 퍼뜨리지 않습니다. 앱이 실제로 필요한 값은 `AirQualitySnapshot`에 모으고, 각 JSON 구조는 별도의 응답 DTO(Data Transfer Object)로 표현합니다. API가 바뀌면 DTO와 서비스 경계만 수정할 수 있습니다.

            @Image(source: "world-coordinate-diagram.svg", alt: "API 응답 DTO가 앱 도메인 모델로 변환되는 구조")
        }
        @Steps {
            @Step {
                위치, 측정 시각, 기온, PM2.5, UV, 풍속·풍향과 일출·일몰을 담은 도메인 모델을 만듭니다. `isSunVisible(at:)`은 일출 이상, 일몰 미만인지를 계산합니다.

                @Code(name: "AirQualitySnapshot.swift", file: "01-AirQualitySnapshot.swift")
            }
            @Step {
                실제 JSON의 `current`, `daily`, `timezone`, `utc_offset_seconds` 구조와 필요한 필드만 `Decodable` 타입으로 선언합니다.

                @Code(name: "OpenMeteoAPIResponse.swift", file: "02-OpenMeteoAPIResponse.swift")
            }
            @Step {
                JSON의 `pm2_5`와 Swift의 `pm25`처럼 이름이 다르면 `CodingKeys`로 매핑합니다. 모든 서버 필드를 선언할 필요는 없습니다.
            }
        }
    }

    @Section(title: "5. 안전하게 요청 URL 만들기") {
        @ContentAndMedia {
            URL 문자열을 `+`로 이어 붙이면 특수문자 인코딩과 `?`, `&` 위치를 실수하기 쉽습니다. `URLComponents`와 `URLQueryItem`을 사용하면 엔드포인트와 매개변수를 구조적으로 조립할 수 있습니다.

            @Image(source: "air-ar-hero.svg", alt: "엔드포인트와 쿼리 항목으로 REST 요청 URL을 구성하는 과정")
        }
        @Steps {
            @Step {
                기상 엔드포인트로 `URLComponents`를 만들고 좌표, 현재 변수, 단위와 시간대를 `URLQueryItem`으로 추가합니다.

                @Code(name: "RESTRequest.swift", file: "02-RESTRequest.swift")
            }
            @Step {
                같은 방식으로 대기질 엔드포인트에는 `current=pm2_5,uv_index`를 추가합니다.
            }
            @Step {
                `components.url` 생성이 실패하면 잘못된 URL 오류로 처리합니다. 강제 언래핑은 고정 예제에서만 보여 주고 실제 서비스에서는 `guard`를 사용합니다.
            }
        }
    }

    @Section(title: "6. HTTP GET을 보내고 JSON 디코딩하기") {
        @ContentAndMedia {
            `URLSession.data(from:)`은 URL에 비동기 `GET` 요청을 보내 `(Data, URLResponse)`를 반환합니다. 네트워크 전송 성공과 API 요청 성공은 다릅니다. 응답이 HTTP인지, 상태 코드가 성공 범위인지 확인한 뒤에만 JSON을 디코딩합니다.

            @Image(source: "air-ar-hero.svg", alt: "URLSession 요청에서 상태 코드 검사와 JSON 디코딩으로 이어지는 흐름")
        }
        @Steps {
            @Step {
                응답을 `HTTPURLResponse`로 변환하고 `200...299`가 아니면 상태 코드를 포함한 오류를 만듭니다.
            }
            @Step {
                `JSONDecoder.decode(_:from:)`로 바이트 데이터인 `Data`를 `Decodable` 응답 DTO로 변환합니다.
            }
            @Step {
                기상과 대기질 요청을 `async let`으로 시작해 네트워크 대기 시간을 겹칩니다. 현지 일출·일몰 문자열은 응답의 시간대로 절대 `Date`로 변환한 뒤 하나의 스냅샷으로 합칩니다.

                @Code(name: "OpenMeteoEnvironmentService.swift", file: "02-OpenMeteoEnvironmentService.swift")
            }
            @Step {
                취소, 네트워크, HTTP 상태, 응답 형식, JSON 디코딩 실패를 서로 다른 서비스 오류로 바꿉니다.
            }
        }
    }

    @Section(title: "7. ViewModel에서 최신 요청만 반영하기") {
        @ContentAndMedia {
            `@MainActor` ViewModel이 로딩 상태와 최신 스냅샷을 소유합니다. 새로고침이 들어오면 이전 Task를 취소하고 요청 세대 번호를 비교해 늦게 도착한 이전 결과가 화면을 덮어쓰지 못하게 합니다.

            @Image(source: "air-ar-hero.svg", alt: "REST 서비스 결과를 SwiftUI 상태로 전달하는 흐름")
        }
        @Steps {
            @Step {
                먼저 공개 상태와 Task 저장 공간을 만듭니다.

                @Code(name: "AirQualityViewModel.swift", file: "03-AirQualityViewModel-start.swift")
            }
            @Step {
                로드, 새로고침, 취소와 최신 요청 판별을 완성합니다.

                @Code(name: "AirQualityViewModel.swift", file: "03-AirQualityViewModel.swift", previousFile: "03-AirQualityViewModel-start.swift")
            }
        }
    }

    @Section(title: "8. AR 월드 추적 시작하기") {
        @ContentAndMedia {
            이 앱은 바닥 평면을 기다리지 않고 공기 중에 오브젝트를 띄웁니다. `ARWorldTrackingConfiguration`의 위치·방향 추적을 사용하고 Coaching Overlay로 초기 움직임을 안내합니다.

            @Image(source: "world-coordinate-diagram.svg", alt: "기기 카메라와 월드 좌표계의 관계")
        }
        @Steps {
            @Step {
                중력과 북쪽 기준의 `gravityAndHeading` 월드 정렬로 세션을 시작합니다.

                @Code(name: "ARSession.swift", file: "04-ARSession.swift")
            }
            @Step {
                `.normal`, `.limited`, 중단, 재개, 미지원 상태를 SwiftUI가 읽을 수 있는 값으로 변환합니다.
            }
        }
    }

    @Section(title: "9. 사용자 중심의 월드 공간 만들기") {
        @ContentAndMedia {
            북쪽 정렬 월드에서 회전 없는 변환에 최초 카메라 위치만 적용해 `AnchorEntity(world:)`를 생성합니다. 앵커의 X축은 동쪽, -Z축은 북쪽과 계속 일치하므로 API 풍향을 올바른 AR 이동 벡터로 바꿀 수 있습니다.

            @Image(source: "air-ar-hero.svg", alt: "최초 사용자 위치를 중심으로 고정된 월드 공간")
        }
        @Steps {
            @Step {
                북쪽 기준 월드 축은 유지하고 카메라 위치만 복사해 앵커를 고정합니다.

                @Code(name: "WorldCoordinate.swift", file: "05-WorldCoordinate.swift")
            }
        }
    }

    @Section(title: "10. PM2.5를 바람에 흐르는 입자로 표현하기") {
        @ContentAndMedia {
            iOS 18의 RealityKit `ParticleEmitterComponent`로 이미지 에셋 없이 먼지를 만듭니다. PM2.5 농도는 초당 생성량과 투명도로, 풍향은 진행 방향으로, 풍속은 이동 속도로 변환합니다. 기상학적 풍향은 바람이 **불어오는** 방향이므로 180° 반대 방향을 먼지 진행 벡터로 사용합니다.

            @Image(source: "pm25-visualization.svg", alt: "RealityKit 파티클 이미터가 사용자 주변에 미세먼지를 생성하는 구조")
        }
        @Steps {
            @Step {
                빈 `Entity`에 `ParticleEmitterComponent`를 만들고 `emitterShape = .box`, `birthLocation = .volume`으로 설정합니다. `emitterShapeSize`를 사용자 주변 크기로 지정하면 한 점이 아니라 공간 전체에서 먼지가 태어납니다.
            }
            @Step {
                PM2.5 값으로 `mainEmitter.birthRate`와 알파를 정합니다. `lifeSpan`, `sizeVariation`, `opacityCurve = .gradualFadeInOut`은 크기와 수명을 흩뜨리고 먼지가 갑자기 나타나거나 사라지는 느낌을 줄입니다. `warmUp`은 배치 직후에도 공간이 이미 채워진 것처럼 보이게 합니다.

                @Code(name: "PM25Visualization.swift", file: "06-PM25Visualization.swift")
            }
            @Step {
                `billboardMode = .billboard`와 색 변화만으로 입자를 그립니다. 따라서 먼지 PNG가 필요하지 않고, 작은 반투명 입자가 어느 카메라 방향에서도 보입니다.
            }
            @Step {
                `noiseStrength`, `noiseScale`, `noiseAnimationSpeed`로 미세한 난류를 만들고, 풍향을 북쪽 기준 진행 벡터로 바꿔 `emissionDirection`에 넣습니다. 풍속은 눈으로 확인 가능한 범위로 제한해 `speed`에 전달합니다.
            }
            @Step {
                파티클 시스템이 생성·이동·소멸과 카메라 정렬을 처리하므로, 수백 개의 `ModelEntity`를 만들거나 `SceneEvents.Update`에서 먼지를 하나씩 움직일 필요가 없습니다.
            }
        }
    }

    @Section(title: "11. UV를 공간 오브젝트로 표현하기") {
        @ContentAndMedia {
            UV Index는 사용자 위에서 내려오는 따뜻한 햇빛으로 표현합니다. PNG 이미지 대신 RealityKit `CustomMaterial`과 Metal surface shader가 빔과 태양 코로나의 모양, 중심 밝기와 투명도를 계산합니다. 현재 시각이 일출부터 일몰 사이일 때만 햇빛 그룹을 표시하고, 태양을 직접 올려다보면 별도의 화면 공간 레이어가 카메라 렌즈에서 생기는 것 같은 빛 번짐을 표시합니다.

            @Image(source: "uv-visualization.svg", alt: "RealityKit 태양과 빔을 화면 공간 렌즈 플레어로 투영하는 구조")
        }
        @Steps {
            @Step {
                새 Metal 파일에 `[[visible]]` surface shader 두 개를 만듭니다. `uvBeamSurface`는 `uv0()`를 `smoothstep`으로 잘라 위는 좁고 아래는 넓은 빔을 만듭니다. `sunCoronaSurface`는 중심에서의 거리와 각도로 흰 중심광, 금빛 후광과 길이가 다른 방사광을 계산합니다.

                @Code(name: "UVBeamShader.metal", file: "07-UVBeamShader.metal")
            }
            @Step {
                Swift에서 기본 Metal 라이브러리의 `uvBeamSurface`와 `sunCoronaSurface`를 찾아 각각 `CustomMaterial`에 연결합니다. `lightingModel: .unlit`은 실제 조명과 관계없이 계산한 색을 그대로 보여 줍니다.
            }
            @Step {
                UV Index를 0...1로 정규화하고 `material.custom.value`에 세기와 투명도를 담습니다. 평면 여덟 개를 겹치면 여러 색이 합성되어 흰 덩어리처럼 보이므로, 따뜻한 단색 평면 두 개만 90°로 교차합니다.
            }
            @Step {
                사용자 위 2.4m에 밝은 `UnlitMaterial` 구와 코로나 평면을 같은 중심에 배치합니다. 매 프레임 코로나가 카메라를 향하게 하므로 어느 방향에서도 둥근 발광으로 보이고, UV가 강할수록 구·코로나·빔이 조금 커지고 밝아집니다. 셰이더 생성에 실패해도 이미지 없는 단색 `UnlitMaterial`로 빔을 계속 표시합니다.

                @Code(name: "UVVisualization.swift", file: "07-UVVisualization.swift")
            }
            @Step {
                `snapshot.isSunVisible(at: Date())`를 매 프레임 확인해 `SunlightGroup.isEnabled`를 전환합니다. 밤에는 태양 구, 코로나와 빔을 함께 숨기고 렌즈 플레어도 즉시 제거합니다. 따라서 앱을 켠 채 일몰을 지나도 새 요청 없이 화면이 밤 상태로 바뀝니다.
            }
            @Step {
                매 프레임 `ARView.project()`로 태양의 월드 좌표를 화면 좌표로 바꿉니다. 카메라 전방 벡터와 태양 방향의 내적이 1에 가까워질수록 플레어 강도를 높입니다.

                @Code(name: "SolarLensFlare.swift", file: "07-SolarLensFlare.swift")
            }
            @Step {
                `SolarLensFlareView`는 Core Animation의 방사형 그라디언트와 도형 레이어만 사용합니다. 정면에서는 주변 노출을 낮추고 태양 코어, 청백색 헤일로, 방사광 18개, 동심원 3개와 화면 중심 반대편으로 이어지는 렌즈 고스트 5개를 표시합니다. 태양이 화면 정중앙에 와도 고스트가 한 점에 겹치지 않도록 최소 광학 축을 유지하며, 화면 밖으로 나가면 모두 즉시 숨깁니다.
            }
        }
    }

    @Section(title: "12. 자동 배치와 화면 연결하기") {
        @ContentAndMedia {
            데이터와 정상 추적 상태가 모두 준비되면 월드 공간에 콘텐츠를 자동 배치합니다. 먼지는 `ParticleEmitterComponent`가 스스로 갱신하고, `SceneEvents.Update`에서는 태양의 표시 시각, 코로나 방향, 빔 맥동과 렌즈 플레어만 갱신합니다. 상단에는 세 수치와 Open-Meteo·CAMS 출처, 하단에는 새로고침만 둡니다.

            @Image(source: "air-ar-hero.svg", alt: "공간에 자동 배치된 환경 오브젝트와 상태 화면")
        }
        @Steps {
            @Step {
                ARView Coordinator에 배치, 업데이트와 프레임 애니메이션을 연결합니다.

                @Code(name: "AirQualityARView.swift", file: "08-AirQualityARView.swift")
            }
            @Step {
                SwiftUI 화면을 ARView, 정보 패널과 새로고침 버튼으로 구성합니다.

                @Code(name: "ContentView.swift", file: "09-ContentView.swift")
            }
            @Step {
                Air Quality API는 CAMS 모델을 기반으로 하므로 Open-Meteo와 CAMS 출처를 함께 표시합니다.
            }
        }
    }

    @Section(title: "13. REST 서비스를 단위 테스트하기") {
        @ContentAndMedia {
            자동 테스트가 실제 인터넷에 의존하면 느리고 불안정합니다. `URLProtocol` 스텁으로 앱이 보낼 URL을 검사하고 원하는 HTTP 상태와 JSON을 즉시 반환합니다.

            @Image(source: "air-ar-hero.svg", alt: "실제 서버 대신 URLProtocol 테스트 스텁이 응답하는 구조")
        }
        @Steps {
            @Step {
                성공 테스트에서 두 호스트, 좌표, `current`·`daily` 변수, 풍속 단위와 시간대를 검사하고 모든 값이 스냅샷에 매핑되는지 확인합니다. 일출 직전·일출·일몰 직전·일몰 경계의 태양 표시 여부도 검증합니다.
            }
            @Step {
                필수 JSON 필드를 빼서 디코딩 오류를, 상태 코드 503을 반환해 HTTP 오류를 확인합니다.
            }
            @Step {
                `URLError.cancelled`가 앱의 취소 오류로 변환되는지 확인합니다.
            }
        }
    }

    @Section(title: "14. 실제 기기에서 확인하기") {
        @ContentAndMedia {
            시뮬레이터는 실제 카메라와 모션 센서를 이용한 월드 트래킹을 검증할 수 없습니다. 컴파일과 단위 테스트 뒤 ARKit 지원 iPhone 또는 iPad에서 권한, API 응답, 월드 고정과 입자 애니메이션을 확인합니다.

            @Image(source: "world-coordinate-diagram.svg", alt: "실제 기기에서 360도 월드 공간 효과를 확인하는 방법")
        }
        @Steps {
            @Step {
                Signing Team을 선택하고 iOS 18 이상 실제 기기에서 실행한 뒤 위치와 카메라 권한을 허용합니다.
            }
            @Step {
                주변을 천천히 비추고 정상 추적 상태에서 세 수치와 시각화가 자동으로 나타나는지 확인합니다.
            }
            @Step {
                새로고침 뒤 기온·PM2.5·UV와 먼지·바람이 함께 갱신되는지 확인합니다.
            }
            @Step {
                제자리에서 360° 회전해 먼지가 월드 공간에 남고 UV가 화면에 붙어 따라오지 않는지 확인합니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            REST API 요청에서 URL은 어떤 역할을 하나요?
            @Choice(isCorrect: true) {
                서버에서 요청할 자원을 가리키는 엔드포인트이며, 앱은 그 주소에 HTTP 요청을 보낸다.

                @Justification(reaction: "정답입니다!") {
                    REST API도 URL로 자원을 식별하며 응답 본문으로 JSON 같은 데이터를 받을 수 있습니다.
                }
            }
            @Choice(isCorrect: false) {
                URL을 사용하면 API가 아니고 반드시 웹 페이지만 받을 수 있다.

                @Justification(reaction: "다시 생각해 보세요.") {
                    같은 URL 체계를 쓰더라도 서버는 요청에 따라 HTML 대신 JSON을 반환할 수 있습니다.
                }
            }
            @Choice(isCorrect: false) {
                URL은 JSON 필드 이름을 Swift 속성으로 바꾸는 도구다.

                @Justification(reaction: "다시 생각해 보세요.") {
                    JSON 필드 매핑은 `Decodable`과 `CodingKeys`가 담당합니다.
                }
            }
        }
    }
}
