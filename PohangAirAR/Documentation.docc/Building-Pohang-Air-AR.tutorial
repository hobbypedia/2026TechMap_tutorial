@Tutorial(time: 90) {
    @Intro(title: "포항의 공기와 햇빛을 AR로 표현하기") {
        SwiftUI, ARKit, RealityKit으로 숫자표가 아닌 움직이는 환경 시각화를 만듭니다. 상단에는 기온·미세먼지·UV만 표시하고, 공간에는 데이터에 따라 양과 강도가 달라지는 오브젝트를 자동 배치합니다.

        @Image(source: "pohang-air-ar-hero.svg", alt: "포항 환경 데이터 AR 앱의 완성 구조")
    }

    @Section(title: "1. 프로젝트와 권한 준비") {
        @ContentAndMedia {
            iOS 17 SwiftUI 앱과 Unit Test Target을 준비합니다. ARKit은 카메라와 모션 센서로 공간을 추적하므로 `NSCameraUsageDescription`이 필요합니다. 앱은 포항의 고정 좌표를 사용하므로 위치 권한은 요청하지 않습니다.

            @Image(source: "pohang-air-ar-hero.svg", alt: "SwiftUI와 ARKit으로 구성된 앱 구조")
        }
        @Steps {
            @Step {
                앱 Target과 테스트 Target의 배포 버전을 iOS 17로 맞추고 SwiftUI, ARKit, RealityKit을 연결합니다.
            }
            @Step {
                `Info.plist`에 카메라가 환경 데이터를 공간에 표시하는 데 사용된다는 설명을 추가합니다.
            }
        }
    }

    @Section(title: "2. 화면용 환경 모델 만들기") {
        @ContentAndMedia {
            네트워크 응답 구조를 화면 전체에 퍼뜨리지 않습니다. 서비스가 기온, PM2.5, UV Index를 하나의 `AirQualitySnapshot`으로 조합하면 SwiftUI와 RealityKit이 같은 값 타입을 공유할 수 있습니다.

            @Image(source: "world-coordinate-diagram.svg", alt: "환경 데이터가 AR 월드로 전달되는 흐름")
        }
        @Steps {
            @Step {
                위치 이름과 측정 시각을 포함한 도메인 모델을 작성합니다.

                @Code(name: "AirQualitySnapshot.swift", file: "01-AirQualitySnapshot.swift")
            }
        }
    }

    @Section(title: "3. 기온과 대기 데이터를 병렬 요청하기") {
        @ContentAndMedia {
            Air Quality API에서는 PM2.5와 UV Index를, Forecast API에서는 현재 기온을 가져옵니다. `async let`으로 두 HTTPS 요청을 병렬 실행하고 둘 다 성공한 뒤 하나의 스냅샷으로 합칩니다.

            @Image(source: "pohang-air-ar-hero.svg", alt: "두 API의 환경 데이터가 하나의 앱 모델로 합쳐지는 개념도")
        }
        @Steps {
            @Step {
                포항시청 좌표 `36.0190, 129.3434`와 서울 시간대를 두 요청에 공통으로 넣습니다.
            }
            @Step {
                HTTP 상태, 디코딩, 취소, 네트워크 오류를 구분하는 서비스를 구현합니다.

                @Code(name: "OpenMeteoAirQualityService.swift", file: "02-OpenMeteoAirQualityService.swift")
            }
        }
    }

    @Section(title: "4. ViewModel에서 최신 요청만 반영하기") {
        @ContentAndMedia {
            `@MainActor` ViewModel이 로딩 상태와 최신 스냅샷을 소유합니다. 새로고침이 들어오면 이전 Task를 취소하고 요청 세대 번호를 비교해 늦게 도착한 이전 결과가 화면을 덮어쓰지 못하게 합니다.

            @Image(source: "pohang-air-ar-hero.svg", alt: "서비스 결과를 SwiftUI 상태로 전달하는 흐름")
        }
        @Steps {
            @Step {
                먼저 공개 상태와 Task 저장 공간을 만듭니다.

                @Code(name: "AirQualityViewModel.swift", file: "03-AirQualityViewModel-start.swift")
            }
            @Step {
                로드, 새로고침, 취소와 최신 요청 판별을 완성합니다.

                @Code(name: "AirQualityViewModel.swift", file: "03-AirQualityViewModel.swift", previousFile: "03-AirQualityViewModel-start.swift")
            }
        }
    }

    @Section(title: "5. AR 월드 추적 시작하기") {
        @ContentAndMedia {
            이 앱은 바닥 평면 위에 놓는 앱이 아니라 공기 중에 환경 오브젝트를 띄웁니다. 따라서 평면 감지를 기다리지 않고 `ARWorldTrackingConfiguration`의 위치·방향 추적을 사용하며 Coaching Overlay로 초기 움직임을 안내합니다.

            @Image(source: "world-coordinate-diagram.svg", alt: "기기 카메라와 월드 좌표계의 관계")
        }
        @Steps {
            @Step {
                중력 기준 월드 정렬로 세션을 시작합니다.

                @Code(name: "ARSession.swift", file: "04-ARSession.swift")
            }
            @Step {
                `.normal`, `.limited`, 중단, 재개, 미지원 상태를 SwiftUI가 읽을 수 있는 값으로 변환합니다.
            }
        }
    }

    @Section(title: "6. 사용자 중심의 월드 공간 만들기") {
        @ContentAndMedia {
            최초 카메라 위치와 수평 방향으로 중력 정렬 변환을 만든 뒤 `AnchorEntity(world:)`를 생성합니다. 이 앵커는 화면이 아니라 실제 공간에 고정됩니다. 먼지는 앵커 주위를 360°로 감싸고 UV 광원은 앵커 바로 위에 놓이므로 기기를 회전해도 방향마다 비슷한 양을 볼 수 있습니다.

            @Image(source: "pohang-air-ar-hero.svg", alt: "최초 사용자 위치를 중심으로 고정된 월드 공간 시각화")
        }
        @Steps {
            @Step {
                카메라의 수평 전방 벡터와 중력의 위쪽 벡터로 월드 변환을 만든 뒤 해당 위치에 앵커를 고정합니다.

                @Code(name: "WorldCoordinate.swift", file: "05-WorldCoordinate.swift")
            }
        }
    }

    @Section(title: "7. 미세먼지를 떠다니는 황토색 입자로 표현하기") {
        @ContentAndMedia {
            PM2.5를 표의 한 행으로 표현하지 않고, 투명도 0.33의 큰 황토색 먼지 스프라이트 개수로 바꿉니다. 입자는 최초 사용자 위치를 둘러싼 원통형 360° 부피에 결정론적으로 흩어지고 매 프레임 카메라를 향해 회전하므로 어느 방향을 봐도 비슷한 밀도로 보입니다. 일반 구간은 8...72개, PM2.5가 76 이상인 심각 구간은 96...144개로 늘고 분포 반경과 높이도 커집니다. 이 매핑은 교육용 표현이며 공식 건강 기준이 아닙니다.

            @Image(source: "dust-particle.png", alt: "투명 배경의 황토색 미세먼지 입자 디자인")
        }
        @Steps {
            @Step {
                `DustParticle.imageset`을 불러와 투명도가 낮은 `UnlitMaterial`에 연결합니다.
            }
            @Step {
                PM2.5 값으로 입자 수를 정하고 방위각과 반경을 이용해 사용자 주변 360° 위치에 스프라이트를 생성합니다.

                @Code(name: "PM25Visualization.swift", file: "06-PM25Visualization.swift")
            }
        }
    }

    @Section(title: "8. UV를 빛나는 공간 오브젝트로 표현하기") {
        @ContentAndMedia {
            UV Index는 게이지나 원형 문양 대신 실제 백색광이 빨강·주황·노랑·초록·파랑·보라 파장으로 퍼지는 스펙트럼으로 표현합니다. 광원 그룹은 최초 사용자 위치의 위쪽 한 월드 지점에 고정하고, 같은 광원점에서 45° 간격으로 방사되는 여덟 개의 경사진 투명 평면을 사용해 회전 방향에 따른 가시성 차이를 줄입니다. 크기는 약 1.65...2.0m로 화면의 약 3분의 2를 비추며, UV가 강할수록 낮게 시작한 불투명도가 올라갑니다.

            @Image(source: "uv-spectrum.png", alt: "투명 배경에서 백색광이 여러 색의 스펙트럼으로 퍼지는 자외선 디자인")
        }
        @Steps {
            @Step {
                `UVSpectrum.imageset` 텍스처를 사용자 위 1.45m의 같은 광원점에서 45° 간격으로 내려오는 여덟 평면 메시와 투명 재질에 적용합니다.
            }
            @Step {
                UV Index로 크기와 광량을 계산하고 광원 그룹을 사용자 바로 위 월드 좌표에 둡니다.

                @Code(name: "UVVisualization.swift", file: "07-UVVisualization.swift")
            }
        }
    }

    @Section(title: "9. 시각화를 자동 배치하고 움직이기") {
        @ContentAndMedia {
            데이터와 정상 추적 상태가 모두 준비되면 버튼 없이 월드 공간에 콘텐츠를 자동 배치합니다. `SceneEvents.Update`를 구독해 먼지는 부유시키면서 항상 현재 카메라를 향하게 하고, 위쪽 한 지점의 UV 평면들은 함께 미세하게 맥동시킵니다. 새 데이터를 받으면 앵커는 유지하고 자식 엔티티만 다시 만듭니다.

            @Image(source: "pohang-air-ar-hero.svg", alt: "공간에 자동 배치된 환경 오브젝트")
        }
        @Steps {
            @Step {
                ARView Coordinator에 배치, 업데이트, 프레임 애니메이션을 연결합니다.

                @Code(name: "AirQualityARView.swift", file: "08-AirQualityARView.swift")
            }
        }
    }

    @Section(title: "10. 상단 정보와 새로고침만 남기기") {
        @ContentAndMedia {
            실제 앱의 조작을 최소화합니다. 카메라 위 상단에는 `온도 | 미세먼지 | UV`를 한 줄로 표시하고, 하단에는 새로고침 버튼 하나만 둡니다. 재배치와 초기화 버튼은 제거하고 AR 콘텐츠는 상태 변화에 맞춰 자동 관리합니다.

            @Image(source: "pohang-air-ar-hero.svg", alt: "상단 정보와 하단 새로고침으로 단순화한 앱 화면")
        }
        @Steps {
            @Step {
                SwiftUI 화면을 ARView, 컴팩트 정보 패널, 새로고침 버튼으로 구성합니다.

                @Code(name: "ContentView.swift", file: "09-ContentView.swift")
            }
        }
    }

    @Section(title: "11. 실제 기기에서 확인하기") {
        @ContentAndMedia {
            시뮬레이터는 실제 카메라와 모션 센서를 이용한 월드 트래킹을 검증할 수 없습니다. 컴파일과 단위 테스트 뒤 ARKit 지원 iPhone 또는 iPad에서 권한, 추적 안정화, 월드 고정 상태와 입자 애니메이션을 확인합니다.

            @Image(source: "world-coordinate-diagram.svg", alt: "실제 기기에서 360도 월드 공간 효과를 확인하는 방법")
        }
        @Steps {
            @Step {
                Signing Team을 선택하고 iOS 17 이상 실제 기기에서 앱을 실행합니다.
            }
            @Step {
                카메라 권한을 허용하고 주변을 천천히 비춥니다. 추적이 정상화되면 시각화가 자동으로 나타나는지 확인합니다.
            }
            @Step {
                제자리에서 기기를 360° 회전해 방향마다 비슷한 미세먼지 밀도가 보이는지 확인합니다. UV는 화면에 붙어 돌지 않고 최초 사용자 위치 위의 같은 월드 지점에 남으면서 여러 방향에서 빛이 보이는지 확인합니다.
            }
            @Step {
                새로고침 뒤 상단의 세 값과 먼지 양·UV 강도가 함께 갱신되는지 확인합니다.
            }
        }
    }

    @Assessments {
        @MultipleChoice {
            PM2.5 값이 높아졌음을 표가 아닌 공간 디자인으로 전달하는 구현은 무엇인가요?
            @Choice(isCorrect: true) {
                낮은 불투명도의 황토색 먼지 스프라이트 개수를 늘리고 서로 다른 위상으로 부유시킨다.

                @Justification(reaction: "정답입니다!") {
                    데이터가 입자의 밀도와 움직임이라는 시각적 분위기로 변환됩니다.
                }
            }
            @Choice(isCorrect: false) {
                PM2.5 값을 표의 셀에만 출력한다.

                @Justification(reaction: "다시 생각해 보세요.") {
                    이 앱의 핵심은 수치를 공간의 밀도로 느끼게 하는 것입니다.
                }
            }
            @Choice(isCorrect: false) {
                값과 관계없이 항상 같은 먼지 이미지를 한 장 표시한다.

                @Justification(reaction: "다시 생각해 보세요.") {
                    입자 양이 데이터와 함께 변해야 합니다.
                }
            }
        }
    }
}
