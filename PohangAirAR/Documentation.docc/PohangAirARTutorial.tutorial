@Tutorials(name: "포항의 환경 데이터를 AR로 시각화하기") {
    @Intro(title: "수치를 공간의 분위기로 바꾸기") {
        Open-Meteo의 기온, PM2.5, UV Index를 받아 미세먼지와 자외선 오브젝트가 실제 공간에 떠 있는 iOS 앱을 완성합니다.

        @Image(source: "pohang-air-ar-hero.svg", alt: "AR 카메라 안에 미세먼지와 자외선 오브젝트가 떠 있는 앱 개념도")
    }

    @Chapter(name: "데이터에서 공간 시각화까지") {
        API 모델, SwiftUI 상태, ARKit 월드 추적, RealityKit 시각화가 하나의 자동 흐름으로 연결됩니다.

        @Image(source: "world-coordinate-diagram.svg", alt: "카메라 좌표를 월드 좌표로 변환하는 개념도")

        @TutorialReference(tutorial: "doc:Building-Pohang-Air-AR")
    }
}
